{
  "name": "tibaldo-jungle-vitrine",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "JUNGLE_ENV=beta NEXT_PUBLIC_JUNGLE_ENV=beta NEXT_PUBLIC_JUNGLE_ORIGIN=https://beta-jungle.tibaldo.fr NEXT_PUBLIC_SHOP_URL=https://beta-shop.tibaldo.fr NEXT_PUBLIC_JUNGLE_BANNER='MODE BÊTA / TEST — ENVIRONNEMENT DE DÉMONSTRATION' WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "npm run build:beta",
    "build:beta": "JUNGLE_ENV=beta NEXT_PUBLIC_JUNGLE_ENV=beta bash scripts/build-verified.sh",
    "build:public": "JUNGLE_ENV=public NEXT_PUBLIC_JUNGLE_ENV=public bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && NEXT_PUBLIC_JUNGLE_ENV=beta NEXT_PUBLIC_JUNGLE_ORIGIN=https://beta-jungle.tibaldo.fr NEXT_PUBLIC_SHOP_URL=https://beta-shop.tibaldo.fr NEXT_PUBLIC_JUNGLE_BANNER='MODE BÊTA / TEST — ENVIRONNEMENT DE DÉMONSTRATION' node --experimental-strip-types --test tests/rendered-html.test.mjs tests/plant-contract.test.ts tests/encyclopedia-p1-expansion.test.ts tests/beta-environment.test.mjs tests/canonical-golden-fidelity.test.mjs tests/v33-iphone-safari-runtime.test.mjs tests/media-rights-p0-closure-v1.test.ts tests/cycas-local-geo-v1.test.ts tests/public-home-universes-v66-hotfix.test.mjs",
    "test:canonical-fidelity": "node --experimental-strip-types --test tests/canonical-golden-fidelity.test.mjs",
    "test:artifact:beta": "JUNGLE_ENV=beta node --experimental-strip-types --test tests/deployment-artifact-contract.test.mjs",
    "test:artifact:public": "JUNGLE_ENV=public node --experimental-strip-types --test tests/deployment-artifact-contract.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "audit:seo": "npm run audit:seo:beta",
    "audit:seo:beta": "JUNGLE_ENV=beta node --experimental-strip-types scripts/seo-audit.mjs",
    "audit:seo:public": "JUNGLE_ENV=public node --experimental-strip-types scripts/seo-audit.mjs",
    "audit:placeholders": "node --experimental-strip-types scripts/audit-placeholders.ts",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Tibaldo Jungle \u2014 Studio Végétal"
}
